# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_DEBUG=true

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=finpulse
POSTGRES_USER=finpulse
POSTGRES_PASSWORD=finpulse
# DSN used by the api service (host = docker-compose service name)
DATABASE_DSN=pgsql:host=db;port=5432;dbname=finpulse
DATABASE_USER=finpulse
DATABASE_PASSWORD=finpulse

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=tcp://redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 chars (256-bit) for HS256. Change it in any non-local env.
JWT_SECRET=change-me-to-a-random-32char-minimum-secret
JWT_TTL=3600

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ── AI worker ─────────────────────────────────────────────────────────────────
# Internal URL of the ai-worker (docker-compose service name).
AI_WORKER_URL=http://ai-worker:8000
# Provider: fake | gemini | claude | openai
# "fake" returns deterministic answers and needs NO credentials (default demo).
LLM_PROVIDER=fake
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── BACEN ─────────────────────────────────────────────────────────────────────
BACEN_BASE_URL=https://api.bcb.gov.br
# Cache TTL (seconds) for fetched series.
BACEN_CACHE_TTL=3600

# ── Crypto spot prices (public Coinbase Data API; no key required) ──────────
COINBASE_BASE_URL=https://api.coinbase.com
CRYPTO_CACHE_TTL=60

# ── Alerts scheduler ──────────────────────────────────────────────────────────
# How often the scheduler evaluates alerts (seconds).
ALERTS_INTERVAL=300
# Cooldown after an alert fires, so it doesn't re-notify every cycle (seconds).
ALERTS_COOLDOWN=3600

# ── Email channel (SMTP) ──────────────────────────────────────────────────────
# Defaults target the bundled Mailpit container (captures mail, UI at :8025).
# Point at Gmail/Brevo/etc. for real delivery.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=         # tls | ssl | (empty)
MAIL_FROM=alerts@finpulse.dev

# ── WhatsApp channel (Meta Cloud API) ─────────────────────────────────────────
# Free in test mode: a test sender number + verified recipients (no billing).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# E.164 recipient (your verified test number), e.g. 5518999999999
WHATSAPP_RECIPIENT=
