#!/usr/bin/env bash
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1
if [[ "${FINPULSE_AUTO_DEPLOY:-1}" == 0 ]]; then
    echo "FinPulse auto-deploy skipped (FINPULSE_AUTO_DEPLOY=0)."
    exit 0
fi

echo "Running FinPulse post-commit deployment..."
if ! make deploy-fast; then
    echo "Commit created, but automatic deployment failed." >&2
    echo "Retry with: make deploy-fast" >&2
    exit 1
fi
